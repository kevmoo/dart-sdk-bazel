# M5 Path-1.5: real kernel_service.dill embed.
# Replaces the empty kKernelServiceDill placeholder previously aliased
# through :bazel_link_stubs. Mirrors runtime/bin/BUILD.gn:765
# (bin_to_linkable "kernel_service_dill_linkable") but uses .incbin
# directly instead of bin_to_assembly.py — 17MB byte-by-byte would
# explode the .S file. The dill is co-located in $(RULEDIR) so the
# assembler can resolve the .incbin path.
genrule(
    name = "dart_kernel_service_dill_S",
    srcs = ["//utils/kernel-service:kernel_service_dill"],
    outs = [
        "dart_kernel_service_dill.S",
        "dart_kernel_service.dill",
    ],
    cmd = "cp $(execpath //utils/kernel-service:kernel_service_dill) $(RULEDIR)/dart_kernel_service.dill && " +
          "SIZE=$$(python3 -c \"import os; print(os.path.getsize('$(RULEDIR)/dart_kernel_service.dill'))\") && " +
          "{" + select({
              "@platforms//os:macos": "  echo '.const'; " +
                                      "  echo '.global _kKernelServiceDill'; " +
                                      "  echo '.balign 32'; " +
                                      "  echo '_kKernelServiceDill:'; " +
                                      "  echo \".incbin \\\"$(RULEDIR)/dart_kernel_service.dill\\\"\"; " +
                                      "  echo '.global _kKernelServiceDillSize'; " +
                                      "  echo '_kKernelServiceDillSize:'; " +
                                      "  echo \".quad $$SIZE\"; ",
              "//conditions:default": "  echo '.section .rodata'; " +
                                      "  echo '.type kKernelServiceDill STT_OBJECT'; " +
                                      "  echo '.global kKernelServiceDill'; " +
                                      "  echo '.balign 32'; " +
                                      "  echo 'kKernelServiceDill:'; " +
                                      "  echo \".incbin \\\"$(RULEDIR)/dart_kernel_service.dill\\\"\"; " +
                                      "  echo '.size kKernelServiceDill, .-kKernelServiceDill'; " +
                                      "  echo '.global kKernelServiceDillSize'; " +
                                      "  echo 'kKernelServiceDillSize:'; " +
                                      "  echo \".quad $$SIZE\"; ",
          }) +
          "} > $(RULEDIR)/dart_kernel_service_dill.S",
)

filegroup(
    name = "dart_kernel_service_dill_S_only",
    srcs = ["dart_kernel_service_dill.S"],
)

