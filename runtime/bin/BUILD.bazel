# Real kDartCoreSnapshotData + kDartCoreSnapshotText (M5 Path-1.5 closeout).
# Replaces the empty placeholders previously aliased through :bazel_link_stubs.
# Mirrors runtime/bin/BUILD.gn:core_snapshot_data_linkable /
# core_snapshot_text_linkable.
#
# Generated natively in Bazel by running gen_snapshot_product in host config
# over the stripped VM platform dill.
genrule(
    name = "core_snapshot_bin",
    srcs = [
        "//runtime/vm:vm_platform_stripped.dill",
    ],
    outs = [
        "core_snapshot_data.bin",
        "core_snapshot_text.bin",
    ],
    cmd = "$(location //runtime/bin:gen_snapshot) --deterministic --snapshot_kind=core " +
          "--snapshot_data=$(location core_snapshot_data.bin) --snapshot_text=$(location core_snapshot_text.bin) " +
          "$(location //runtime/vm:vm_platform_stripped.dill)",
    tools = [
        "//runtime/bin:gen_snapshot",
    ],
)

