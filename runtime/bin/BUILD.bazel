genrule(
    name = "dart_icudata_S",
    srcs = ["@icu//flutter:icudtl.dat"],
    outs = ["dart_icudata.S"],
    cmd = "python3 $(location //runtime/tools:bin_to_assembly.py) " +
          "--input $(location @icu//flutter:icudtl.dat) " +
          "--output $@ " +
