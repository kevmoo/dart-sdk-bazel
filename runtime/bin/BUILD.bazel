          select({
              "@platforms//os:linux": "--target_os linux",
              "@platforms//os:macos": "--target_os mac",
              "//conditions:default": "--target_os linux",
          }) + " " +
          select({
              "@platforms//cpu:arm64": "--target_arch arm64",
              "@platforms//cpu:x86_64": "--target_arch x64",
              "//conditions:default": "--target_arch x64",
          }),
    tools = ["//runtime/tools:bin_to_assembly.py"],
)

