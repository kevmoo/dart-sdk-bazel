# HAND-AUTHORED BUILD.bazel for //runtime/vm — the §7 overlay (NOT translator-written).
#
# The machine-derived cc_* targets live in the generated gen_targets.bzl macro
# (refreshed by tools/bazel/translate_gn_desc.py); this file load()s + calls it and
# owns every HAND-FIXED target. The translator NEVER overwrites this file, so a
# regen cannot clobber these hand-fixes. See docs/todo_issues/m4_multiconfig_scoping.md §7.

load("//tools/bazel:rules.bzl", "cc_binary", "cc_library")
load("//tools/bazel/dart:defs.bzl", "dart_compile_platform")
load(":gen_targets.bzl", "gen_targets")

package(default_visibility = ["//visibility:public"])

# GN lets one target's sources reach into other BUILD.gn dirs; Bazel
# requires cross-package file refs to be explicitly exported. Bulk-export
# every file in the package so the gn-shaped source lists keep working.
exports_files(glob(
    [
        "**/*.h",
        "**/*.hpp",
        "**/*.hh",
        "**/*.inc",
        "**/*.cc",
        "**/*.cpp",
        "**/*.c",
        "**/*.S",
        "**/*.s",
    ],
    allow_empty = True,
))

# Machine-derived cc_* targets (see gen_targets.bzl).
gen_targets()

