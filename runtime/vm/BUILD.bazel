# replacing the pre-staged out/ReleaseX64/vm_platform.dill blob. Ports
# runtime/vm/BUILD.gn:gen_vm_platform("vm_platform") — postfix "", exclude_source
# false, product false (dart_runtime_mode != "release" for ReleaseX64). The
# output file //runtime/vm:vm_platform.dill is consumed by the kPlatformDill
# embed in //runtime/bin and the kernel_worker snapshot in //utils/bazel.
