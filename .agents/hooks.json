{
  "pre-commit-bazel-validator": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./.agents/scripts/validate_bazel_commit.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
