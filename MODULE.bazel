module(
    name = "dart_sdk",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_pkg", version = "1.0.1")

# Provides bool_flag (//build/config:dart_debug) for the M4 debug<->release
# select() axis. Already in the resolved graph transitively (selected 1.8.2);
# declared here to make @bazel_skylib//rules:common_settings.bzl loadable.
bazel_dep(name = "bazel_skylib", version = "1.8.2")

dart_clang = use_extension("//build/toolchain/linux:clang_repo.bzl", "dart_clang")
use_repo(dart_clang, "dart_linux_x64_clang", "dart_linux_x64_sysroot")

dart_android_ndk = use_extension("//build/toolchain/android:ndk_repo.bzl", "dart_android_ndk")
use_repo(dart_android_ndk, "dart_android_ndk")

dart_ios_sdk = use_extension("//build/toolchain/ios:sdk_repo.bzl", "dart_ios_sdk")
use_repo(dart_ios_sdk, "dart_ios_sdk")

register_toolchains(
    "//build/toolchain/linux:clang_x64_toolchain",
    "//build/toolchain/linux:clang_arm64_toolchain",
    "//build/toolchain/android:android_clang_arm64_linux_toolchain",
    "//build/toolchain/android:android_clang_arm64_macos_arm64_toolchain",
    "//build/toolchain/ios:ios_clang_arm64_macos_toolchain",
    "//build/toolchain/ios:ios_clang_sim_x64_macos_toolchain",
    "//tools/bazel/dart:prebuilt_dart_toolchain",
)

dart_tests = use_extension("//tools/bazel/dart:test_rules.bzl", "dart_tests_extension")
use_repo(
    dart_tests,
    "dart_tests",
)

third_party = use_extension("//tools/bazel:third_party.bzl", "third_party_extension")
use_repo(third_party, "binaryen", "boringssl", "chrome", "chromedriver", "dart_co19_tests", "devtools", "firefox", "icu", "perfetto", "prebuilt_dart_sdk", "zlib")

dart_packages = use_extension("//tools/bazel/dart:packages_extension.bzl", "dart_packages_extension")
use_repo(dart_packages, "dart_packages")
