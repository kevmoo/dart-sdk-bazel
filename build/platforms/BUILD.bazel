package(default_visibility = ["//visibility:public"])

constraint_setting(name = "environment")

constraint_value(
    name = "device",
    constraint_setting = ":environment",
)

constraint_value(
    name = "simulator",
    constraint_setting = ":environment",
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "android_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
)

platform(
    name = "android_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:android",
    ],
)

platform(
    name = "android_arm",
    constraint_values = [
        "@platforms//cpu:armv7",
        "@platforms//os:android",
    ],
)

platform(
    name = "android_riscv64",
    constraint_values = [
        "@platforms//cpu:riscv64",
        "@platforms//os:android",
    ],
)

platform(
    name = "fuchsia_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:fuchsia",
    ],
)

platform(
    name = "fuchsia_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:fuchsia",
    ],
)

platform(
    name = "ios_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:ios",
        ":device",
    ],
)

platform(
    name = "ios_sim_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:ios",
        ":simulator",
    ],
)

platform(
    name = "ios_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:ios",
        ":simulator",
    ],
)

platform(
    name = "ios_arm",
    constraint_values = [
        "@platforms//cpu:armv7",
        "@platforms//os:ios",
        ":device",
    ],
)
