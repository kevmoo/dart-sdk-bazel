# HAND-AUTHORED — NOT emitted by tools/bazel/translate_gn_desc.py. This is the
# clobber-safe home for the M4 multi-config select() machinery: a translator
# regen never writes build/config/BUILD.bazel, so the config_setting + select()s
# below survive it (recon §7 overlay strategy). See
# docs/todo_issues/m4_multiconfig_scoping.md (§3 delta / §6 folding / §7 overlay).
#
# Scope = two graph-isolated config-axis mechanism proofs: the debug<->release
# axis (#1, below) and the product axis (#2, the PRODUCT define — bottom of file).
# The arch and OS axes (recon §8) remain out of scope, as does WIRING either axis
# into the real runtime targets (the translator-generalization slice does that).

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# The debug<->release axis flag. Default false == the release flag set the
# migration builds today (out/ReleaseX64). A custom build setting rather than
# --compilation_mode so Dart's DEBUG/NDEBUG assertion axis stays decoupled from
# Bazel's optimization level — the VM forces -O2 in BOTH modes (recon §3), so
# Dart-debug is not Bazel's -c dbg. Flip with --//build/config:dart_debug=true.
bool_flag(
    name = "dart_debug",
    build_setting_default = False,
)

config_setting(
    name = "debug",
    flag_values = {":dart_debug": "true"},
)

config_setting(
    name = "release_macos",
    constraint_values = ["@platforms//os:macos"],
    flag_values = {":dart_debug": "false"},
)

config_setting(
    name = "release_linux",
    constraint_values = ["@platforms//os:linux"],
    flag_values = {":dart_debug": "false"},
)

config_setting(
    name = "release_android",
    constraint_values = ["@platforms//os:android"],
    flag_values = {":dart_debug": "false"},
)

config_setting(
    name = "release_ios",
    constraint_values = ["@platforms//os:ios"],
    flag_values = {":dart_debug": "false"},
)

config_setting(
    name = "os_macos",
    constraint_values = ["@platforms//os:macos"],
)

config_setting(
    name = "os_android",
    constraint_values = ["@platforms//os:android"],
)

config_setting(
    name = "os_ios",
    constraint_values = ["@platforms//os:ios"],
)

config_setting(
    name = "cpu_x64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "cpu_arm64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

string_flag(
    name = "dart_target_arch",
    build_setting_default = "",
    values = [
        "",
        "x64",
        "arm",
        "arm64",
        "riscv32",
        "riscv64",
        "simarm",
        "simarm64",
        "simriscv32",
        "simriscv64",
    ],
)

config_setting(
    name = "target_arch_x64",
    flag_values = {":dart_target_arch": "x64"},
)

config_setting(
    name = "target_arch_arm64",
    flag_values = {":dart_target_arch": "arm64"},
)

config_setting(
    name = "target_arch_simarm",
    flag_values = {":dart_target_arch": "simarm"},
)

config_setting(
    name = "target_arch_simarm64",
    flag_values = {":dart_target_arch": "simarm64"},
)

config_setting(
    name = "target_arch_simriscv32",
    flag_values = {":dart_target_arch": "simriscv32"},
)

config_setting(
    name = "target_arch_simriscv64",
    flag_values = {":dart_target_arch": "simriscv64"},
)

config_setting(
    name = "target_arch_default_x64",
    constraint_values = ["@platforms//cpu:x86_64"],
    flag_values = {":dart_target_arch": ""},
)

config_setting(
    name = "target_arch_default_arm64",
    constraint_values = ["@platforms//cpu:aarch64"],
    flag_values = {":dart_target_arch": ""},
)

# The single shared mechanism (recon §6): ONE config_setting + ONE select()-driven
# carrier folds the whole debug<->release delta, instead of 141 per-target
# select()s. A cc_library dep propagates `defines` and `linkopts` to its
# dependents, so those two halves of the delta live here and reach a consumer via
# deps = [":dart_mode"]. The delta tokens are exactly recon §3:
#   defines:  NDEBUG (release) <-> DEBUG (debug)
#   linkopts: 4 release-only -Wl opts, dropped in debug
# PRODUCT (recon §3/§8, the product axis) is intentionally excluded.
cc_library(
    name = "dart_mode",
    defines = select({
        ":debug": ["DEBUG"],
        "//conditions:default": ["NDEBUG"],
    }) + select({
        ":target_arch_arm64": ["TARGET_ARCH_ARM64"],
        ":target_arch_default_arm64": ["TARGET_ARCH_ARM64"],
        ":target_arch_default_x64": ["TARGET_ARCH_X64"],
        ":target_arch_simarm": ["TARGET_ARCH_ARM"],
        ":target_arch_simarm64": ["TARGET_ARCH_ARM64"],
        ":target_arch_simriscv32": ["TARGET_ARCH_RISCV32"],
        ":target_arch_simriscv64": ["TARGET_ARCH_RISCV64"],
        ":target_arch_x64": ["TARGET_ARCH_X64"],
        "//conditions:default": [],
    }),
    linkopts = select({
        ":release_android": [
            "-Wl,--gc-sections",
            "-Wl,-z,max-page-size=65536",
            "-Wl,--exclude-libs=libc++_static.a",
        ],
        ":release_ios": [
            "-Wl,-dead_strip",
        ],
        ":release_linux": [
            "-Wl,--icf=all",
            "-Wl,-O2",
            "-Wl,--gc-sections",
            "-Wl,--as-needed",
        ],
        ":release_macos": [
            "-Wl,-dead_strip",
        ],
        "//conditions:default": [],
    }) + select({
        ":os_android": [
            "-llog",
            "-landroid",
            "-ldl",
        ],
        ":os_ios": [
            "-framework",
            "CoreFoundation",
            "-framework",
            "Foundation",
            "-framework",
            "Security",
        ],
        ":os_macos": [
            "-framework",
            "CoreFoundation",
            "-framework",
            "CoreServices",
            "-framework",
            "Foundation",
            "-framework",
            "Security",
        ],
        "//conditions:default": [],
    }),
)

# Mechanism proof / representative consumer ("the slice"). cc_binary so there is a
# real link action to observe the linkopts flip on. `copts`/`cxxopts` do NOT
# propagate from a cc_library dep (Bazel applies them only to a target's own
# srcs), so the copt + cxxopt halves of the delta are applied here via the SAME
# :debug config_setting — recon §3:
#   copts:   -fno-ident (release-only), dropped in debug
#   cxxopts: 2 debug-only -Wno warning suppressions, absent in release
# defines + linkopts arrive via the :dart_mode dep. The translator-generalization
# slice (later) will deliver copts/cxxopts to the 141 real targets via a
# cc_toolchain feature or per-target inline select(); that is out of scope here.
cc_binary(
    name = "mode_probe",
    srcs = ["mode_probe.cc"],
    copts = select({
        ":debug": [],
        "//conditions:default": ["-fno-ident"],
    }),
    cxxopts = select({
        ":debug": [
            "-Wno-tautological-undefined-compare",
            "-Wno-undefined-bool-conversion",
        ],
        "//conditions:default": [],
    }),
    deps = [":dart_mode"],
)

# ============================================================================
# M4 mechanism proof #2 — the product axis (PRODUCT define), PARALLEL to the
# debug<->release axis above. Graph-isolated; NO wiring into real targets.
# ============================================================================

# The product<->non-product axis flag. Default false == today's non-product
# release (out/ReleaseX64). A custom build setting, separate from :dart_debug,
# because PRODUCT is its own axis: recon §3 shows the PRODUCT define tracks the
# product-variant targets (the 58 *_product targets) INDEPENDENTLY of the
# debug<->release split, so it earns its own config_setting (recon §8 — "PRODUCT
# is better attached to a product config_setting"). Flip with
# --//build/config:dart_product=true.
bool_flag(
    name = "dart_product",
    build_setting_default = False,
)

config_setting(
    name = "product",
    flag_values = {":dart_product": "true"},
)

# Flag to build DevTools from sources instead of using prebuilt assets.
bool_flag(
    name = "dart_build_devtools_from_sources",
    build_setting_default = False,
)

config_setting(
    name = "devtools_from_sources",
    flag_values = {":dart_build_devtools_from_sources": "true"},
)

# Product delta carrier — mirrors :dart_mode. A cc_library whose select()-driven
# `defines` fold the product axis and propagate to a consumer via deps. The whole
# product flag-surface delta on this slice is the single PRODUCT define (recon §3):
# present under :product, absent otherwise.
#
# Out of scope (kept atomic): full product also drops the service-isolate
# srcs/deps (recon §8) — a follow-up; this proof is the PRODUCT define only.
cc_library(
    name = "dart_product_mode",
    defines = select({
        ":product": ["PRODUCT"],
        "//conditions:default": [],
    }),
)

# Product-axis probe / representative consumer — mirrors :mode_probe. Reuses the
# trivial mode_probe.cc TU; `deps = [":dart_product_mode"]` brings PRODUCT in via
# define propagation, so it lands on this target's CppCompile under
# --//build/config:dart_product=true and is absent by default (byte-identical to
# pre-change). Graph-isolated: no real target depends on it.
cc_binary(
    name = "product_probe",
    srcs = ["mode_probe.cc"],
    deps = [":dart_product_mode"],
)

cc_library(
    name = "dart_mode_no_arch",
    defines = select({
        ":debug": ["DEBUG"],
        "//conditions:default": ["NDEBUG"],
    }),
    linkopts = select({
        ":release_android": [
            "-Wl,--gc-sections",
            "-Wl,-z,max-page-size=65536",
            "-Wl,--exclude-libs=libc++_static.a",
        ],
        ":release_ios": [
            "-Wl,-dead_strip",
        ],
        ":release_linux": [
            "-Wl,--icf=all",
            "-Wl,-O2",
            "-Wl,--gc-sections",
            "-Wl,--as-needed",
        ],
        ":release_macos": [
            "-Wl,-dead_strip",
        ],
        "//conditions:default": [],
    }) + select({
        ":os_android": [
            "-llog",
            "-landroid",
            "-ldl",
        ],
        ":os_ios": [
            "-framework",
            "CoreFoundation",
            "-framework",
            "Foundation",
            "-framework",
            "Security",
        ],
        ":os_macos": [
            "-framework",
            "CoreFoundation",
            "-framework",
            "CoreServices",
            "-framework",
            "Foundation",
            "-framework",
            "Security",
        ],
        "//conditions:default": [],
    }),
)
