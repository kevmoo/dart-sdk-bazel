# ==============================================================================
# BAZEL REMOTE EXECUTION & CACHING CONFIGURATION TEMPLATE
# ==============================================================================
#
# Copy these configurations into your project's root `.bazelrc` or import it:
# try-import %workspace%/infra/remote_execution/bazelrc
#
# To use these configs, run:
#   bazel build --config=remote //...
#   or
#   bazel build --config=remote-cache //...
#
# Authenticate before running:
#   gcloud auth application-default login
#

# ------------------------------------------------------------------------------
# 1. REMOTE CACHE ONLY (Run locally, share cache in GCS)
# ------------------------------------------------------------------------------
build:remote-cache --remote_cache=https://storage.googleapis.com/dart-sdk-bazel-cache
build:remote-cache --google_default_credentials=true
build:remote-cache --remote_cache_async

# Enable upload to cache (CI should always do this, devs can optionally disable it if they have slow upload)
build:remote-cache --remote_upload_local_results=true

# Fallback to local execution if the remote cache is down
build:remote-cache --remote_local_fallback=true

# Trip circuit breaker and stop remote cache calls if over 5% of requests fail within a 10s window (e.g. auth failures or rate limits)
build:remote-cache --experimental_circuit_breaker_strategy=failure
build:remote-cache --experimental_remote_failure_rate_threshold=5
build:remote-cache --experimental_remote_failure_window_interval=10s
# Do not waste time retrying unauthenticated or failing requests when falling back to local execution
build:remote-cache --remote_retries=1
# Print test failure logs to stdout in CI and remote runs
test:remote-cache --test_output=errors

# ------------------------------------------------------------------------------
# 2. FULL REMOTE EXECUTION (Run in GKE, share cache)
# ------------------------------------------------------------------------------
# Point to the GKE Buildfarm Server LoadBalancer IP or Domain
build:remote --remote_executor=grpc://<BUILDFARM_SERVER_IP_OR_DOMAIN>:8980
build:remote --remote_cache=grpc://<BUILDFARM_SERVER_IP_OR_DOMAIN>:8980
build:remote --google_default_credentials=true

# Required for remote execution to map local toolchains to remote workers
build:remote --spawn_strategy=remote
build:remote --strategy=Javac=remote
build:remote --strategy=Closure=remote

# Enable bytes receiving/sending optimization
build:remote --remote_download_outputs=toplevel # Only download final artifacts, not intermediate ones (massive speedup!)

# Set timeout for remote actions
build:remote --remote_timeout=3600

# Fallback to local if remote execution fails unexpectedly
build:remote --remote_local_fallback=true

# Trip circuit breaker and stop remote calls if over 5% of requests fail within a 10s window
build:remote --experimental_circuit_breaker_strategy=failure
build:remote --experimental_remote_failure_rate_threshold=5
build:remote --experimental_remote_failure_window_interval=10s
build:remote --remote_retries=1
test:remote --test_output=errors

# ------------------------------------------------------------------------------
# 3. BUILD EVENTS / DASHBOARD (Stream to local BuildBuddy tunnel)
# ------------------------------------------------------------------------------
# To use this, you must run the port-forwarding tunnels:
#   kubectl port-forward -n bazel-buildfarm service/buildbuddy 1985:1985
#   kubectl port-forward -n bazel-buildfarm service/buildbuddy 8080:8080
#
# Then run:
#   bazel build --config=remote --config=buildbuddy //...
#
build:buildbuddy --bes_backend=grpc://localhost:1985
build:buildbuddy --bes_results_url=http://localhost:8080/invocation/
