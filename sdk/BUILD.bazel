# rules_dart Step 5 assembly (sdk-xh6): the create_* targets are filegroup
# aggregators that stage the SDK tree under dart-sdk/ (re-rooted in sdk-9xn).
# They were cc_library, which fails analysis when depping the 5.1/5.2 filegroups
# ("no CcInfo provider"); filegroup is the correct file-tree aggregator. So
# //sdk:create_sdk is STRUCTURALLY analysis-green -- it collects the real
# binaries/libraries/snapshots/resources plus the empty stub members below (which
# contribute no files). Those stubs are the documented POST-WRAP functional gaps;
# see "Structural create_sdk gaps" in docs/todo_issues/STATUS.md.
filegroup(
    name = "create_common_sdk",
    srcs = [
        "//sdk:copy_api_readme",
        "//sdk:copy_dart",
        "//sdk:copy_dart_sym",
        "//sdk:copy_dartdoc_files",
        "//sdk:copy_dartvm",
        "//sdk:copy_dartvm_sym",
        "//sdk:copy_devtools",
        "//sdk:copy_headers",
        "//sdk:copy_libraries_specification",
        "//sdk:copy_license",
        "//sdk:copy_process_test",
        "//sdk:copy_readme",
        "//sdk:copy_sdk_packages_yaml",
        "//sdk:copy_vm_dill_files",
        "//sdk:copy_vm_strong_dill_files",
        "//sdk:group_dart2native",
        "//sdk:write_dartdoc_options",
        "//sdk:write_revision_file",
        "//sdk:write_version_file",
    ],
)

filegroup(
    name = "create_full_sdk",
    srcs = [
        "//runtime/bin:gen_snapshot_product_linux_arm",
        "//runtime/bin:gen_snapshot_product_linux_arm64",
        "//runtime/bin:gen_snapshot_product_linux_riscv64",
        "//runtime/bin:gen_snapshot_product_linux_x64",
        "//sdk:copy_dart2js_dill_files",
        "//sdk:copy_dart2wasm_platform",
        "//sdk:copy_dart2wasm_snapshot",
        "//sdk:copy_dev_compiler_sdk",
        "//sdk:copy_full_sdk_libraries",
        "//sdk:copy_full_sdk_scripts",
        "//sdk:copy_full_sdk_snapshots",
        "//sdk:copy_wasm_opt",
    ],
)

filegroup(
    name = "create_platform_sdk",
    srcs = [
        "//sdk:_create_platform_sdk",
        "//sdk:create_common_sdk",
    ],
)

filegroup(
    name = "create_sdk",
    srcs = [
        "//sdk:create_common_sdk",
        "//sdk:create_full_sdk",
    ],
)

filegroup(
    name = "group_dart2native",
