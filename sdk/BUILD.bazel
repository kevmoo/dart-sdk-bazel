genrule(
    name = "write_dartdoc_options",
    srcs = [
        "//tools:utils.py",
        "//tools:write_dartdoc_options_file.py",
    ],
    outs = ["dart-sdk/dartdoc_options.yaml"],
    cmd = "python3 $(location //tools:write_dartdoc_options_file.py) --output $@ --no-git-hash",
)

genrule(
    name = "write_revision_file",
    outs = ["dart-sdk/revision"],
    cmd = "(grep SDK_GIT_HASH bazel-out/volatile-status.txt || echo \"SDK_GIT_HASH unknown\") | cut -d' ' -f2- > $@",
    stamp = 1,
)

genrule(
    name = "write_version_file",
    outs = ["dart-sdk/version"],
    cmd = "(grep STABLE_SDK_VERSION bazel-out/stable-status.txt || echo \"STABLE_SDK_VERSION 0.0.0-unknown\") | cut -d' ' -f2- > $@",
    stamp = 1,
)
