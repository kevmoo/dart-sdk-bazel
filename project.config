[access "refs/heads/*"]
	label-Commit-Queue = +0..+2 group dart-sdk-external-committers
	label-Commit-Queue = +0..+2 group mdb/dart-team
	label-Commit-Queue = +0..+1 group cria/project-dart-tryjob-access
	abandon = group dart-sdk-external-committers
	abandon = group mdb/dart-team
	labelAs-Commit-Queue = +0..+2 group commit-queue
	labelAs-Commit-Queue = group mdb/dart-team
	submit = group commit-queue
	submit = group dart-sdk-external-committers
	submit = group mdb/dart-team
	label-Auto-Submit = +0..+1 group Change Owner
	label-Code-Review = -1..+1 group dart-sdk-external-committers
[label "Commit-Queue"]
	abbreviation = CQ
	value = 0 Not ready
	value = +1 Dry run
	value = +2 Commit
	defaultValue = 0
	function = NoBlock
	copyCondition = changekind:NO_CHANGE
[label "Auto-Submit"]
	function = NoBlock
	defaultValue = 0
	value = 0 Do not send CL to CQ automatically after approval
	value = +1 Send CL to CQ automatically after approval
	copyCondition = changekind:NO_CHANGE OR changekind:NO_CODE_CHANGE OR changekind:TRIVIAL_REBASE OR is:MAX OR is:MIN
[access "refs/for/refs/*"]
	exclusiveGroupPermissions = addPatchSet
	addPatchSet = group commit-queue
	addPatchSet = group dart-sdk-external-committers
	addPatchSet = group mdb/dart-team
	create = group dart-sdk-external-committers
	create = group mdb/dart-team
	forgeAuthor = group dart-sdk-external-committers
	forgeAuthor = group mdb/dart-team
	push = group dart-sdk-external-committers
	push = group mdb/dart-team
	abandon = group dart-sdk-external-committers
	abandon = group mdb/dart-team
[submit]
	action = rebase always
	matchAuthorToCommitterDate = true
[access "refs/heads/analyzer"]
	submit = deny group commit-queue
	submit = deny group dart-sdk-external-committers
	submit = deny group mdb/dart-team
[access "refs/heads/dev"]
	push = group dart-sdk-merge
[access "refs/heads/base"]
	push = group dart-sdk-base-roller
	submit = block group dart-sdk-external-committers
	submit = block group mdb/dart-team
[access "refs/heads/lkgr"]
	push = group dart-sdk-lkgr-roller
	rebase = group dart-sdk-lkgr-roller
	submit = block group dart-sdk-external-committers
	submit = block group mdb/dart-team
[access "^refs/for/refs/heads/(base|lkgr)/.*"]
	create = block group dart-sdk-external-committers
	create = block group mdb/dart-team
	push = block group dart-sdk-external-committers
	push = block group mdb/dart-team
[access "refs/tags/*"]
	createTag = group dart-sdk-release
[access "^refs/tags/.*dev"]
	createTag = group dart-sdk-merge
[access "refs/*"]
	read = group Anonymous Users
	read = group Registered Users
[access "^refs/heads/(beta|stable)"]
	push = group dart-sdk-merge
[submit-requirement "Commit-Message-Has-TEST"]
	description = "Dart VM changes must include a 'Tested: <description of how this change was tested>' footer. See also: https://github.com/dart-lang/sdk/wiki/Gerrit-Submit-Requirements#commit-message-has-test"
	applicableIf = NOT ownerin:bots AND NOT is:pure-revert AND directory:\"^(runtime/(vm|bin|lib|include|observatory|observatory_2)|pkg/vm|sdk/lib/_internal/vm)\"
	submittableIf = hasfooter:Tested OR message:\"^.*\nTEST(ED)?=.+\"
	canOverrideInChildProjects = false
[submit-requirement "Core-Library-Review"]
	description = "SDK core library changes need to be approved for each platform or have a 'CoreLibraryReviewExempt: <reason>' footer. See also: https://github.com/dart-lang/sdk/wiki/Gerrit-Submit-Requirements#core-library-review"
	applicableIf = NOT ownerin:bots AND NOT is:pure-revert AND path:\"^sdk/lib/[^_].*\\.dart$\"
	submittableIf = hasfooter:CoreLibraryReviewExempt OR ((label:Code-Review=+1,group=mdb/dart-core-library-change-approvers-api OR ownerin:mdb/dart-core-library-change-approvers-api) AND (label:Code-Review=+1,group=mdb/dart-core-library-change-approvers-vm OR ownerin:mdb/dart-core-library-change-approvers-vm) AND (label:Code-Review=+1,group=mdb/dart-core-library-change-approvers-wasm OR ownerin:mdb/dart-core-library-change-approvers-wasm) AND (label:Code-Review=+1,group=mdb/dart-core-library-change-approvers-web OR ownerin:mdb/dart-core-library-change-approvers-web))
	canOverrideInChildProjects = false
[submit-requirement "Changelog"]
	description = "Stable cherry-picks must explain the changes in CHANGELOG.md or have a 'Changelog-Exempt: reason' footer. See also: https://github.com/dart-lang/sdk/wiki/Cherry-picks-to-a-release-channel#changelog"
	applicableIf = branch:stable
	submittableIf = path:CHANGELOG.md OR hasfooter:Changelog-Exempt
