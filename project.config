[access "refs/heads/*"]
	pushMerge = group dart-sdk-external-committers
	pushMerge = group mdb/dart-team
	label-Commit-Queue = +0..+2 group dart-sdk-external-committers
	label-Commit-Queue = +0..+2 group mdb/dart-team
	abandon = group dart-sdk-external-committers
	abandon = group mdb/dart-team
	labelAs-Commit-Queue = +0..+2 group chrome-commit-bot
	labelAs-Commit-Queue = group mdb/dart-team
	submit = group chrome-commit-bot
	submit = group dart-sdk-external-committers
	submit = group mdb/dart-team
	deleteOwnChanges = group dart-sdk-external-committers
	deleteOwnChanges = group mdb/dart-team
	label-Code-Review = -1..+1 group dart-sdk-external-committers
[label "Commit-Queue"]
	abbreviation = CQ
	value = 0 Not ready
	value = +1 Dry run
	value = +2 Commit
	defaultValue = 0
	function = NoBlock
[access "refs/for/refs/*"]
	exclusiveGroupPermissions = addPatchSet
	addPatchSet = group chrome-commit-bot
	addPatchSet = group dart-sdk-external-committers
	addPatchSet = group mdb/dart-team
	create = group dart-sdk-external-committers
	create = group mdb/dart-team
	forgeAuthor = group dart-sdk-external-committers
	forgeAuthor = group mdb/dart-team
	push = group dart-sdk-external-committers
	push = group mdb/dart-team
	deleteOwnChanges = group dart-sdk-external-committers
	deleteOwnChanges = group mdb/dart-team
	abandon = group dart-sdk-external-committers
	abandon = group mdb/dart-team
[submit]
	action = rebase always
	matchAuthorToCommitterDate = true
