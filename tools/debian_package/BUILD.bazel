# AUTO-GENERATED by tools/bazel/translate_gn_desc.py from `gn desc` output.
# Hand-fixes belong in this file (M3); rerun the translator to refresh structural
# bits and re-apply fixes from version control.

package(default_visibility = ["//visibility:public"])

# GN lets one target's sources reach into other BUILD.gn dirs; Bazel
# requires cross-package file refs to be explicitly exported. Bulk-export
# every file in the package so the gn-shaped source lists keep working.
exports_files(glob(
    [
        "**/*.h",
        "**/*.hpp",
        "**/*.hh",
        "**/*.inc",
        "**/*.cc",
        "**/*.cpp",
        "**/*.c",
        "**/*.S",
        "**/*.s",
    ],
    allow_empty = True,
))

# genrule for debian_package (gn type=action)
genrule(
    name = "debian_package",
    srcs = [
        "//sdk:create_sdk",
        "//sdk:copy_dart",  # Include copy_dart output to easily locate dart-sdk dir
        "//tools:utils.py",
        "//:LICENSE",
        "create_debian_package.py",
        "get_version.py",
        "get_timestamp.py",
        "debian/compat",
        "debian/control",
        "debian/dart.install",
        "debian/dart.links",
        "debian/rules",
        "debian/source/format",
    ],
    outs = ["dart.deb"],
    cmd = """
    # 1. Symlink the SDK to dart-sdk at the root of the build directory
    SDK_FILE="$(execpath //sdk:copy_dart)"
    SDK_DIR="$$(dirname $$(dirname $$(dirname $$SDK_FILE)))"
    cp -R "$$SDK_DIR/dart-sdk" dart-sdk
    chmod -R +w dart-sdk

    # 2. Run the packaging script
    ARCH=$$(uname -m)
    if [ "$$ARCH" = "x86_64" ]; then
        DEB_ARCH="amd64"
        LIB_DIR="/lib/x86_64-linux-gnu"
        if [ ! -d "$$LIB_DIR" ]; then
            LIB_DIR="buildtools/sysroot/linux/lib/x86_64-linux-gnu"
        fi
    elif [ "$$ARCH" = "aarch64" ]; then
        DEB_ARCH="arm64"
        LIB_DIR="/lib/aarch64-linux-gnu"
        if [ ! -d "$$LIB_DIR" ]; then
            LIB_DIR="buildtools/sysroot/linux/lib/aarch64-linux-gnu"
        fi
    else
        echo "Unsupported architecture: $$ARCH" >&2
        exit 1
    fi

    python3 $(execpath create_debian_package.py) \
        --version="$$(python3 $(execpath get_version.py))" \
        --timestamp="$$(python3 $(execpath get_timestamp.py))" \
        --arch="$$DEB_ARCH" \
        --lib_dir="$$LIB_DIR"

    # 3. Copy the output debian package to the expected Bazel output path
    mv dart_*.deb $@
    """,
    tags = ["no-sandbox"],  # Runs locally to access host tools like dpkg-buildpackage and fakeroot
)
