genrule(
    name = "generate_needed_files",
    srcs = [
        "@//third_party/binaryen:generate_needed_files.py",
        "src/src/passes/wasm-intrinsics.wat",
        "src/src/passes/WasmIntrinsics.cpp.in",
        "src/CMakeLists.txt",
        "src/config.h.in",
    ],
    outs = [
        "WasmIntrinsics.cpp",
        "config.h",
    ],
    cmd = "python3 $(execpath @//third_party/binaryen:generate_needed_files.py) " +
          "$(execpath src/src/passes/wasm-intrinsics.wat) " +
          "$(execpath src/src/passes/WasmIntrinsics.cpp.in) " +
          "$(execpath WasmIntrinsics.cpp) " +
          "$(execpath src/CMakeLists.txt) " +
          "$(execpath src/config.h.in) " +
          "$(execpath config.h)",
)

