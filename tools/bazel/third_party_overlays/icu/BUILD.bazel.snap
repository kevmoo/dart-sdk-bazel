# M5 hand-crafted shim. NOT translator output. Gitignored.
#
# Path-1 source-level mapping: Dart's GN aggregates ALL source/common/*.cpp
# and source/i18n/*.cpp into a pair of source_sets (icuuc / icui18n). The
# upstream icu/source/{common,i18n}/BUILD.bazel ships per-feature cc_libraries
# which don't combine into the same aggregate. We list every .cpp explicitly
# (via labels exported by the upstream BUILDs) and apply the same defines as
# build/icu/BUILD.gn's icu_config + icu_code configs.

load("//tools/bazel:rules.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

_ICU_DEFINES = [
    "U_USING_ICU_NAMESPACE=0",
    "U_ENABLE_DYLOAD=0",
    "USE_CHROMIUM_ICU=1",
    "U_ENABLE_TRACING=1",
    "U_ENABLE_RESOURCE_TRACING=0",
    "U_STATIC_IMPLEMENTATION",
    "ICU_UTIL_DATA_IMPL=ICU_UTIL_DATA_FILE",
    "HAVE_DLOPEN=0",
    "UCONFIG_ONLY_HTML_CONVERSION=1",
    "UCONFIG_USE_ML_PHRASE_BREAKING=1",
    "UCONFIG_USE_WINDOWS_LCID_MAPPING_API=0",
    "U_CHARSET_IS_UTF8=1",
]

_ICU_COPTS = [
    "-Ithird_party/icu/source/common",
    "-Ithird_party/icu/source/i18n",
    "-Ithird_party/icu/source/stubdata",
    "-Wno-unused-function",
    "-Wno-unused-but-set-variable",
    "-Wno-deprecated-declarations",
    "-std=c++20",
]

cc_library(
    name = "icuuc",
    srcs = [
        # Empty ICU data stub — provides icudt77_dat needed at link time
        # when icu_use_data_file=true. The actual data is loaded at
        # runtime via udata_setCommonData(kIcuData, ...). Without the
        # stub, the BSS symbol icudt77_dat is undefined.
        "//third_party/icu/source/stubdata:stubdata.cpp",
        "//third_party/icu/source/stubdata:stubdata.h",
        # Data tables — upstream :headers excludes these (they're
        # auto-regenerated in icu's own Bazel build) but Dart uses the
        # checked-in versions. Include as private hdrs.
