package(default_visibility = ["//visibility:public"])

filegroup(
    name = "co19_files",
    srcs = glob(
        ["**/*"],
        exclude = [
            "BUILD",
            "BUILD.bazel",
            "WORKSPACE",
            "MODULE.bazel",
        ],
        allow_empty = True,
    ),
)
