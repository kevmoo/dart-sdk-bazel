package(default_visibility = ["//visibility:public"])

exports_files(glob(
    ["**/*"],
    allow_empty = True,
))

filegroup(
    name = "co19_files",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = [
            "BUILD",
            "BUILD.bazel",
            "WORKSPACE",
            "MODULE.bazel",
        ],
    ),
)

filegroup(
    name = "Language_files",
    srcs = glob(
        ["Language/**/*", "Utils/**/*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "LanguageFeatures_files",
    srcs = glob(
        ["LanguageFeatures/**/*", "Utils/**/*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "LibTest_files",
    srcs = glob(
        ["LibTest/**/*", "Utils/**/*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "TypeSystem_files",
    srcs = glob(
        ["TypeSystem/**/*", "Utils/**/*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "VM_files",
    srcs = glob(
        ["VM/**/*", "Utils/**/*"],
        allow_empty = True,
    ),
)

