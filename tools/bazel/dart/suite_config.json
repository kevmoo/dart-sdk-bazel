{
  "packages": {
    "co19": {
      "timeouts_by_pattern": {
        "**": "long"
      }
    },
    "corelib": {
      "timeouts_by_pattern": {
        "**": "long"
      }
    },
    "pkg/analysis_server": {
      "extra_baseline_deps": [
        "@//sdk:sdk_library_sources",
        "@//sdk:version",
        "@prebuilt_dart_sdk//:bin/dart"
      ],
      "quarantine_patterns": [
        "test/**"
      ]
    },
    "pkg/analyzer": {
      "extra_baseline_deps": [
        "@//sdk:sdk_library_sources",
        "@//sdk:version",
        "@prebuilt_dart_sdk//:bin/dart"
      ],
      "manual_patterns": [
        "tool/**",
        "test/verify_*_test.dart"
      ],
      "quarantine_patterns": [
        "test/**"
      ],
      "extra_deps_by_pattern": {
        "test/id_tests/**": [
          "@dart_packages//pkg/_fe_analyzer_shared:sdk_package_sources"
        ],
        "test/verify_*_test.dart": [
          "@dart_packages//pkg/analysis_server:sdk_package_sources",
          "@dart_packages//pkg/front_end:sdk_package_sources",
          "@dart_packages//pkg/_fe_analyzer_shared:sdk_package_sources"
        ]
      }
    },
    "pkg/dart2wasm": {
      "extra_baseline_deps": [
        "@//:dart2wasm_test_resources"
      ],
      "timeouts_by_pattern": {
        "**": "long"
      }
    },
    "pkg/front_end": {
      "quarantine_patterns": [
        "test/**"
      ],
      "timeouts_by_pattern": {
        "**": "long"
      },
      "extra_deps_by_pattern": {
        "test/id_tests/**": [
          "@dart_packages//pkg/_fe_analyzer_shared:sdk_package_sources"
        ]
      }
    },
    "pkg/test_api": {
      "quarantine_patterns": [
        "test/**"
      ]
    }
  },
  "global_extra_deps_by_pattern": {
    "tool/messages/generate_test.dart": [
      "@dart_packages//pkg/front_end:sdk_package_sources",
      "@dart_packages//pkg/analysis_server:sdk_package_sources"
    ]
  }
}


