{
  "packages": {
    "co19": {
      "timeouts_by_pattern": {
        "**": "long"
      }
    },
    "corelib": {
      "timeouts_by_pattern": {
        "**": "long"
      }
    },
    "pkg/analysis_server": {
      "extra_baseline_deps": [
        "@//sdk:sdk_library_sources",
        "@//sdk:version",
        "@prebuilt_dart_sdk//:bin/dart"
      ],
      "quarantine_patterns": [
        "test/verify_sorted_test.dart",
        "test/src/plugin/plugin_manager_test.dart",
        "test/tool/lsp_spec/readme_test.dart",
        "test/src/services/completion/yaml/pubspec_generator_test.dart",
        "test/lsp/completion_yaml_test.dart",
        "test/lsp/pub_package_service_test.dart",
        "test/benchmarks_test.dart"
      ]
    },
    "pkg/analyzer": {
      "extra_baseline_deps": [
        "@//sdk:sdk_library_sources",
        "@//sdk:version",
        "@prebuilt_dart_sdk//:bin/dart"
      ],
      "manual_patterns": [
        "tool/**",
        "test/verify_*_test.dart"
      ],
      "extra_deps_by_pattern": {
        "test/id_tests/**": [
          "@dart_packages//pkg/_fe_analyzer_shared:sdk_package_sources"
        ],
        "test/verify_*_test.dart": [
          "@dart_packages//pkg/analysis_server:sdk_package_sources",
          "@dart_packages//pkg/front_end:sdk_package_sources",
          "@dart_packages//pkg/_fe_analyzer_shared:sdk_package_sources"
        ]
      }
    },
    "pkg/dart2wasm": {
      "extra_baseline_deps": [
        "@//:dart2wasm_test_resources"
      ],
      "timeouts_by_pattern": {
        "**": "long"
      }
    },
    "pkg/front_end": {
      "quarantine_patterns": [
        "test/**"
      ],
      "timeouts_by_pattern": {
        "**": "long"
      },
      "extra_deps_by_pattern": {
        "test/id_tests/**": [
          "@dart_packages//pkg/_fe_analyzer_shared:sdk_package_sources"
        ]
      }
    },
    "pkg/test_api": {
      "quarantine_patterns": [
        "test/**"
      ]
    },
    "language": {
      "quarantine_patterns": [
        "mixin_declaration/mixin_declaration_superinvocation_application_test.dart",
        "least_upper_bound/least_upper_bound_greatest_closure_2_test.dart"
      ],
      "extra_deps_by_pattern": {
        "unsorted/extract_type_arguments_test.dart": [
          "@dart_packages//pkg/dart_internal:sdk_package_sources"
        ]
      }
    }
  },
  "global_extra_deps_by_pattern": {
    "tool/messages/generate_test.dart": [
      "@dart_packages//pkg/front_end:sdk_package_sources",
      "@dart_packages//pkg/analysis_server:sdk_package_sources"
    ]
  }
}


