# Package marker so //tools/bazel/dart:defs.bzl is loadable.
# The Dart-compilation rule macros live in defs.bzl.

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":defs.bzl", "dart_binary", "dart_library", "dart_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "copytree.py",
])

toolchain_type(name = "toolchain_type")

dart_binary(
    name = "test_hello",
    main = "test_hello.dart",
    sources = "@dart_packages//pkg/args",
)

dart_library(
    name = "suite_paths_lib",
    srcs = [
        "suite_paths.dart",
        "suite_paths_test.dart",
    ],
)

dart_binary(
    name = "suite_paths_test_bin",
    main = "suite_paths_test.dart",
    sources = ":suite_paths_lib",
)

sh_test(
    name = "suite_paths_test",
    srcs = [":suite_paths_test_bin"],
)

dart_toolchain(
    name = "prebuilt_dart_toolchain_impl",
    dart_executable = "@prebuilt_dart_sdk//:bin/dart",
    sdk_files = "@prebuilt_dart_sdk//:sdk_files",
    sdk_hash = "0000000000",
)

toolchain(
    name = "prebuilt_dart_toolchain",
    toolchain = ":prebuilt_dart_toolchain_impl",
    toolchain_type = ":toolchain_type",
)

copy_file(
    name = "runfiles_package_config",
    src = "//:package_config_json",
    out = "package_config.json",
)
