# Package marker so //tools/bazel/dart:defs.bzl is loadable.
# The Dart-compilation rule macros live in defs.bzl.

load(":defs.bzl", "dart_binary", "dart_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "copytree.py",
])

toolchain_type(name = "toolchain_type")

dart_binary(
    name = "test_hello",
    main = "test_hello.dart",
    sources = "@dart_packages//pkg/args",
)

dart_toolchain(
    name = "prebuilt_dart_toolchain_impl",
    dart_executable = "@prebuilt_dart_sdk//:bin/dart",
    sdk_files = "@prebuilt_dart_sdk//:sdk_files",
    sdk_hash = "0000000000",
)

toolchain(
    name = "prebuilt_dart_toolchain",
    toolchain = ":prebuilt_dart_toolchain_impl",
    toolchain_type = ":toolchain_type",
)

genrule(
    name = "runfiles_package_config",
    srcs = ["//:package_config_json"],
    outs = ["package_config.json"],
    cmd = "cp $< $@",
)
