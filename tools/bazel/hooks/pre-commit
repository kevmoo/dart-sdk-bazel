#!/usr/bin/env bash
# Auto-canonicalize staged Bazel files and audit them for architecture safety.
set -uo pipefail

# 1. Identify files to format (standard Bazel files only)
files_to_format=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)(BUILD\.bazel|MODULE\.bazel)$|\.bzl$' \
  | grep -v 'gen_targets\.bzl' || true)

if [ -n "$files_to_format" ] && command -v buildifier >/dev/null 2>&1; then
  echo "$files_to_format" | xargs buildifier --lint=fix
  echo "$files_to_format" | xargs git add
fi

# 2. Audit all Bazel and snapshot files for hardcoded host-specific target/cpu cflags and defines
files_to_audit=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)(BUILD\.bazel|MODULE\.bazel)$|\.bzl$|\.snap$|\.append$' \
  | grep -E -v 'gen_targets\.bzl|rules\.bzl|^build/config/' || true)

if [ -n "$files_to_audit" ]; then
  forbidden_patterns=(
    '"-m64"'
    '"-march=x86-64"'
    '"-msse2"'
    '"--target=x86_64-linux-gnu"'
    '"TARGET_ARCH_X64"'
  )
  
  failed=0
  for pattern in "${forbidden_patterns[@]}"; do
    # Check if the pattern exists in any of the staged files
    if echo "$files_to_audit" | xargs grep -F "$pattern" >/dev/null 2>&1; then
      echo "🚨 ERROR: Staged Bazel file contains hardcoded host architecture flag/define: $pattern"
      # Find the exact files and line numbers that failed
      echo "$files_to_audit" | xargs grep -H -F -n "$pattern" || true
      failed=1
    fi
  done

  if [ "$failed" -eq 1 ]; then
    echo "👉 Please remove these flags or parameterize them dynamically using select()."
    echo "👉 Cross-compilation targeting ARM64 will fail if host cflags are hardcoded."
    exit 1
  fi

  # Report-only: string-concat forms like "TARGET_ARCH_" + "X64" evaluate
  # identically but evade the literal grep above. Surfaced as a warning, not a
  # failure, until the policy decision in bead sdk-u2u (allowlist the existing
  # arch-pinned cross variants vs. narrow the audit) is made.
  if echo "$files_to_audit" | xargs grep -H -n -E '"TARGET_ARCH_"[[:space:]]*\+' 2>/dev/null; then
    echo "⚠️  WARNING: concat-built TARGET_ARCH_ define(s) above evade the literal audit (policy pending: bead sdk-u2u)."
  fi
fi

