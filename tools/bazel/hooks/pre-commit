#!/usr/bin/env bash
# Auto-canonicalize staged Bazel files and audit them for architecture safety.
set -uo pipefail

# 1. Identify files to format (standard Bazel files only)
files_to_format=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)(BUILD\.bazel|MODULE\.bazel)$|\.bzl$' \
  | grep -v 'gen_targets\.bzl' || true)

if [ -n "$files_to_format" ] && command -v buildifier >/dev/null 2>&1; then
  echo "$files_to_format" | xargs buildifier --lint=fix
  echo "$files_to_format" | xargs git add
fi

# 2. Audit all Bazel and snapshot files for hardcoded host-specific target/cpu cflags and defines
files_to_audit=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)(BUILD\.bazel|MODULE\.bazel)$|\.bzl$|\.snap$|\.append$' \
  | grep -E -v 'gen_targets\.bzl|rules\.bzl|^build/config/' || true)

if [ -n "$files_to_audit" ]; then
  forbidden_patterns=(
    '"-m64"'
    '"-march=x86-64"'
    '"-msse2"'
    '"--target=x86_64-linux-gnu"'
    '"TARGET_ARCH_X64"'
  )
  
  failed=0
  for pattern in "${forbidden_patterns[@]}"; do
    # Lines carrying the structured allowlist marker are exempt: explicitly
    # arch-pinned cross variants (e.g. *_product_linux_x64 targets)
    # legitimately carry their arch define. The marker keeps the exemption
    # honest and visible in review instead of obfuscated.
    matches=$(echo "$files_to_audit" | xargs grep -H -F -n "$pattern" 2>/dev/null \
      | grep -v '# arch-pinned-variant: ok' || true)
    if [ -n "$matches" ]; then
      echo "🚨 ERROR: Staged Bazel file contains hardcoded host architecture flag/define: $pattern"
      echo "$matches"
      failed=1
    fi
  done

  # Obfuscated concat forms ("TARGET_ARCH_" + "X64") evaluate identically but
  # dodge the literal greps. Never allowed: write the honest literal (plus the
  # marker if the target is a deliberately arch-pinned variant).
  concat_matches=$(echo "$files_to_audit" | xargs grep -H -n -E '"TARGET_ARCH_"[[:space:]]*\+' 2>/dev/null || true)
  if [ -n "$concat_matches" ]; then
    echo "🚨 ERROR: concat-built TARGET_ARCH_ define(s) evade the literal audit:"
    echo "$concat_matches"
    failed=1
  fi

  if [ "$failed" -eq 1 ]; then
    echo "👉 Please remove these flags or parameterize them dynamically using select()."
    echo "👉 For a deliberately arch-pinned cross variant, write the honest literal"
    echo "   and append '  # arch-pinned-variant: ok' to the line."
    echo "👉 Cross-compilation targeting ARM64 will fail if host cflags are hardcoded."
    exit 1
  fi
fi

