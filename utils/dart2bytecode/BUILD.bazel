load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel/dart:defs.bzl", "dart_aot_snapshot")

package(default_visibility = ["//visibility:public"])

# GN lets one target's sources reach into other BUILD.gn dirs; Bazel
# requires cross-package file refs to be explicitly exported. Bulk-export
# every file in the package so the gn-shaped source lists keep working.
exports_files(glob(
    [
        "**/*.h",
        "**/*.hpp",
        "**/*.hh",
        "**/*.inc",
        "**/*.cc",
        "**/*.cpp",
        "**/*.c",
        "**/*.S",
        "**/*.s",
    ],
    allow_empty = True,
))

cc_library(
    name = "dart2bytecode",
    data = [
        ":dart2bytecode_snapshot",
    ],
)

# Ports utils/dart2bytecode/BUILD.gn:aot_snapshot("dart2bytecode_snapshot")
# force_product_mode = !dart_debug -> product in Release configs.
dart_aot_snapshot(
    name = "dart2bytecode_snapshot",
    out = "dart2bytecode.dart.snapshot",
    gen_kernel_dill = "//utils/gen_kernel:bootstrap_gen_kernel",
    gen_snapshot = "//runtime/bin:gen_snapshot_product",
    main = "//:pkg/dart2bytecode/bin/dart2bytecode.dart",
    platform_dill = "//runtime/vm:vm_platform.dill",
    product = True,
    sources = "@dart_packages//pkg/dart2bytecode",
)
