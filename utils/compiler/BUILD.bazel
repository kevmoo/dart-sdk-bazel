# rules_dart Step 4: real dart2js app-jit snapshot. Ports
# utils/compiler/BUILD.gn:application_snapshot("dart2js"). Unblocked by the
# session-16 compile_dart2js_platform web variant. main_dart is the generated
# entry-point (same dart2js.dart the AOT ports use, from dart2js_create_snapshot_entry).
# The training run compiles pkg/compiler/lib/src/util/memory_compiler.dart with
# --platform-binaries pointing at the dir holding the in-Bazel dart2js_platform.dill /
# dart2js_outline.dill ($(RULEDIR) — :compile_dart2js_platform emits into the same
# package output dir as this genrule), which elides re-running the CFE on sdk sources.
# Mirrors GN training_deps=[:compile_dart2js_platform] + training_inputs via training_srcs
# (the dills + libraries.json). The macro emits the `dart2js` genrule (drop-in for the
# GN target name) + dart2js_dill.
dart_app_jit_snapshot(
    name = "dart2js",
    out = "dart2js.dart.snapshot",
    dart_vm = "//runtime/bin:dartvm",
    gen_kernel_dill = "//utils/gen_kernel:bootstrap_gen_kernel",
    main = "dart2js.dart",
    platform_dill = "//runtime/vm:vm_platform.dill",
    product = False,
    sources = "@dart_packages//pkg/compiler",
    training_args = [
        "--invoker=gn_build",
        # Skip the end-of-compile RAM query: it calls Service.controlWebServer,
        # which makes the VM spawn `<exe_dir>/dart development-service` (DDS).
        # Next to the Bazel-built dartvm no `dart` CLI exists, the spawn throws,
        # and the awaiting future never completes — hanging the training run.
        "--omit-memory-summary",
        "--packages=$(location @dart_packages//:package_config_json)",
        "--libraries-spec=sdk/lib/libraries.json",
        # Elides running the CFE on the sdk sources (GN comment). $(RULEDIR) is
        # a genrule make-var and is NOT expanded in training_args (bash would
        # see a literal `$(RULEDIR)` and emit "RULEDIR: command not found"), so
        # derive the directory from the platform dill's expandable location.
        "--platform-binaries=$(dirname $(location :dart2js_platform.dill))/",
        # Resolve the training entry inside the @dart_packages virtual repo (its
        # pkg/ symlinks back into the workspace) so the CFE canonicalizes it to
        # package:compiler/... and sibling relative imports resolve. The dirname
        # is shell-substituted at training time from the package config's path.
        "$(dirname $(location @dart_packages//:package_config_json))/../pkg/compiler/lib/src/util/memory_compiler.dart",
    ],
    training_srcs = [
        ":dart2js_platform.dill",
        ":dart2js_outline.dill",
        "//sdk:sdk_library_sources",
    ],
)

